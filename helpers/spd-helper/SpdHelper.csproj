<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WatchX.SpdHelper</RootNamespace>
    <AssemblyName>spd-helper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RAMSPDToolkit" Version="1.6.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="_timing_probe\**" />
    <Compile Remove="_api_probe2\**" />
    <None Remove="_timing_probe\**" />
    <None Remove="_api_probe2\**" />
  </ItemGroup>
</Project>
